# Zugang für `npm run deploy`. Kopieren nach .env.deploy und ausfüllen.
# .env.deploy steht in .gitignore und gehört nicht ins Repository.

# SSH-Ziel, Port und Web-Ordner auf dem Hosting
DEPLOY_HOST=benutzer@server.example
DEPLOY_PORT=22
DEPLOY_PATH=/pfad/zum/web-ordner

# Adresse für die Prüfung nach dem Upload
DEPLOY_URL=https://wporbit.ch

# Wie viele Sicherungen auf dem Server bleiben
KEEP_BACKUPS=10
