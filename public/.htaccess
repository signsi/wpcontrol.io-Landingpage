# wporbit.ch auf Apache (Plesk): saubere Adressen für die vorgerenderten Seiten.
#
# Der Build legt jede Seite als <pfad>.html ab, z. B. kontakt.html,
# blog/kategorie/sicherheit.html. Ohne diese Regeln liefert der Server für
# /kontakt ein 404 und für /cloud (gleichnamiger Bilderordner) ein 403.

Options -Indexes -MultiViews
# Kein automatischer Schrägstrich bei Ordnern: /cloud ist die Seite, nicht der
# Ordner mit den Bildern.
DirectorySlash Off

RewriteEngine On

# Zeichensatz mitschicken: Der Build setzt <meta charset> erst nach den
# SEO-Tags, also nicht in den ersten 1024 Bytes.
AddDefaultCharset UTF-8

# Alte Adressen
RewriteRule ^features/?$ /produkt/funktionen [R=301,L]
RewriteRule ^custom/?$ /massgeschneidert [R=301,L]
RewriteRule ^waitlist/?$ /testen [R=301,L]

# Eine Adresse pro Seite: /index.html → /, /pfad.html → /pfad.
# THE_REQUEST, damit nur Anfragen von aussen umgeleitet werden und nicht die
# interne Umschreibung weiter unten (sonst Endlosschleife).
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteCond %1 !^404$
RewriteRule ^ /%1 [R=301,L]

# /pfad/ → /pfad (eine Adresse pro Seite)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /pfad → /pfad.html, wenn es die Seite gibt
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ /$1.html [L]

ErrorDocument 404 /404.html

# Interne Build-Dateien nicht ausliefern
RedirectMatch 404 ^/\.vite(/|$)

# Schriften mit richtigem Typ ausliefern
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

# Caching: Dateien mit Prüfsumme im Namen (assets/) ändern sich nie, also
# ein Jahr; Schriften und Bilder einen Monat; HTML immer frisch.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff2|ttf|webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|json|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
